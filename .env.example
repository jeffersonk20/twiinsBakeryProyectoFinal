# Copia este archivo a .env y completa los valores privados de tu entorno.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Genera una clave aleatoria larga para las sesiones de Flask.
SECRET_KEY=
SESSION_COOKIE_SECURE=false

# Código de un solo uso (32 caracteres aleatorios o más) para crear el primer administrador.
ADMIN_SETUP_TOKEN=

# Credenciales OAuth de Wompi El Salvador y URL pública HTTPS de esta aplicación.
WOMPI_CLIENT_ID=
WOMPI_CLIENT_SECRET=
URL_BASE_TUWEB=
