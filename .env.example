# Copia este archivo a .env y completa los valores de tu entorno.

# Configuración del motor de base de datos:
# Usa 'sqlite' para desarrollo local inmediato y sin dependencias externas (Recomendado).
# Usa 'mysql' para conectar a Aiven o a un servidor MySQL/MariaDB.
# Usa 'auto' para intentar conectar a MySQL y usar SQLite como respaldo si falla.
DB_TYPE=sqlite

# Parámetros MySQL / Aiven (necesarios si DB_TYPE=mysql o auto)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_TIMEOUT=4
DB_DISABLE_SSL=false

# Genera una clave aleatoria larga para las sesiones de Flask.
SECRET_KEY=twins_bakery_2026_clave_privada_8f3a9c2d
SESSION_COOKIE_SECURE=false

# Modo local combinado; Render usa customer en la tienda y admin en el panel.
APP_MODE=combined
CLIENT_URL=

# Código de seguridad (32 caracteres o más) para registrar el primer administrador.
ADMIN_SETUP_TOKEN=twins_bakery_admin_token_2026_super_seguro_token_32chars

# Credenciales OAuth de Wompi El Salvador y URL pública HTTPS de esta aplicación.
WOMPI_CLIENT_ID=
WOMPI_CLIENT_SECRET=
URL_BASE_TUWEB=

# Configuración de Correo Electrónico (Gmail SMTP)
# Para Gmail: usa smtp.gmail.com, puerto 587 y una Contraseña de Aplicación de 16 caracteres de Google.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion
MAIL_DEFAULT_SENDER="TWINS Bakery <tu_correo@gmail.com>"
